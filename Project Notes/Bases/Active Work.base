views:
  - type: table
    name: Active Work
    filters:
      or:
        - 'status == "draft"'
        - 'status == "active"'
        - 'status == "in-progress"'
        - 'status == "blocked"'
        - 'status == "partial"'
        - 'status == "investigating"'
        - 'status == "fixed-uncommitted"'
    order:
      - file.name
      - type
      - status
      - area
      - last_verified
