views:
  - type: table
    name: Active Work
    filters:
      and:
        - or:
            - 'status == "draft"'
            - 'status == "active"'
            - 'status == "in-progress"'
            - 'status == "blocked"'
            - 'status == "partial"'
            - 'status == "investigating"'
            - 'status == "fixed-uncommitted"'
        - or:
            - 'type == "task"'
            - 'type == "evidence"'
            - 'type == "incident"'
            - 'type == "decision"'
            - 'type == "release"'
            - 'type == "audit"'
    order:
      - file.name
      - type
      - status
      - area
      - last_verified
